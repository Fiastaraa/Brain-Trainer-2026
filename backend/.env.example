PORT=5000
NODE_ENV=development

# MySQL Database connection URL format:
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/brain_trainer_db"

# JWT Auth Secret & Expiration
JWT_SECRET="super_secret_jwt_key_change_me_in_production_123456"
JWT_EXPIRES_IN="7d"

# CORS Client URL
CLIENT_URL="http://localhost:5173"

# Optional Gemini AI API Key (Falls back automatically to smart procedural engine if empty)
GEMINI_API_KEY=""
